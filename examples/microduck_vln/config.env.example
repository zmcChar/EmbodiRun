# Copy to config.env (ignored by Git) and set paths for your installation.
export MICRODUCK_PROJECT_ROOT=/path/to/microduck-assets
export MICRODUCK_PYTHON=/path/to/EmbodiRun/.venv-microduck/bin/python
# Defaults to this repository's third_party/embodiinfer checkout when omitted.
# export MICRODUCK_INFERENCE_ROOT=/path/to/EmbodiInfer
# Optional compatibility overlay for an already provisioned cluster environment.
# export MICRODUCK_RUNTIME_OVERLAY=/path/to/compatibility-overlay
# off: local GPU; auto: request Slurm only outside an existing allocation.
export MICRODUCK_SLURM=off
# Cluster-specific settings, used only when Slurm is selected.
# export MICRODUCK_PARTITION=your_gpu_partition
export MICRODUCK_CPUS=4
export MICRODUCK_TIME=01:00:00
